---
interface Props {
  href?: string;
}

const { href } = Astro.props;
const Element = href ? "a" : "span";
---

<Element
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
  data-href={Boolean(href).toString()}
  class="group/w-item py-2 text-inherit inline-block w-full no-underline hover:text-mauve-900 hover:pr-4 focus:text-mauve-900 focus:pr-4"
>
  <slot />
</Element>
