---
import { WORK_EXPERIENCE } from "@/features/shared/data/cv";
import PageContainer from "@/features/shared/components/page-container.astro";
import PageInfo from "@/features/shared/components/page-info.astro";
---

<PageContainer>
  <div class="space-y-8">
    <PageInfo content="Work" />
    <div class="text-neutral-600 font-medium text-sm space-y-4 leading-6.5">
      <div>
        <p>
          Over the years, I've had the chance to work with a few great teams and
          build things I care about.
        </p>
      </div>
      <div class="font-semibold mb-1!">
        <p class="text-primary w-max pr-2">
          Where I've been{" "}
          <span class="font-mono relative -top-1 animate-[arrow-bottom_4s_steps(5,end)_forwards_infinite]">
            ↴
          </span>
        </p>
      </div>
      <div class="group/wrapper">
        {WORK_EXPERIENCE.map((work) => {
          const hasHref = work.href !== undefined;

          if (!hasHref) {
            return (
              <span class="text-inherit no-underline" data-href="false">
                <div class="group/item hover:px-2 hover:text-text transition-[padding,opacity] py-2 group-hover/wrapper:not-hover:opacity-60 group-hover/wrapper:not-hover:blur-[1px] flex items-center justify-between gap-4 duration-300">
                  <p class="text-sm flex items-center justify-start gap-1">
                    {work.company}
                    {work.sufix ? <span>{work.sufix}</span> : null}
                  </p>
                  <span class="text-xs font-medium text-neutral-400 group-hover/item:text-neutral-600 transition-colors duration-300">
                    {work.year}
                  </span>
                </div>
              </span>
            );
          }

          return (
            <a
              href={work.href}
              data-href={"true"}
              class="text-inherit no-underline"
              target="_blank"
              rel="noopener"
            >
              <div class="group/item hover:px-2 hover:text-text transition-[padding,opacity] py-2 group-hover/wrapper:not-hover:opacity-60 group-hover/wrapper:not-hover:blur-[1px] flex items-center justify-between gap-4 duration-300">
                <p class="text-sm flex items-center justify-start gap-1">
                  {work.company}
                  {work.sufix ? <span>{work.sufix}</span> : null}
                  {hasHref && (
                    <img
                      class="-rotate-45 relative top-0.5 -translate-x-1 opacity-0 group-hover/item:translate-x-3 group-hover/item:opacity-100 duration-300"
                      src="/assets/arr.webp"
                      alt="arrow-right"
                      width="12"
                      height="12"
                    />
                  )}
                </p>
                <span class="text-xs font-medium text-neutral-400 group-hover/item:text-neutral-600 transition-colors duration-300">
                  {work.year}
                </span>
              </div>
            </a>
          );
        })}
      </div>
      <div>
        <p>
          For more detailed look, feel free to check my{" "}
          <a class="social-link" href="/cv">
            CV
          </a>
          .
        </p>
      </div>
    </div>
  </div>
</PageContainer>

<style>
  @keyframes arrow-bottom {
    0% {
      top: -4px;
    }
    100% {
      top: 8px;
    }
  }
</style>
