---
import PageContainer from "@/features/shared/components/page-container.astro";
import PageInfo from "@/features/shared/components/page-info.astro";
import Social from "./social.astro";
import About from "./about.astro";
import Work from "./work.astro";
import Banner from "@/features/shared/components/banner.astro";
---

<PageContainer>
  <div class="space-y-10 selection:text-mauve-900">
    <div class="space-y-8">
      <PageInfo content="Profile" />
      <Banner
        src="/assets/banner/profile.jpg"
        alt="Profile banner"
        location="Durgam Cheruvu, India"
      />
    </div>
    <div class="text-mauve-600 space-y-10">
      <About />
      <Work />
      <Social />
    </div>
  </div>
</PageContainer>
