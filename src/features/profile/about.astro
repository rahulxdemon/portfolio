---
import Heading from "./heading.astro";
import { CURRENT_COMPANY } from "@/features/portfolio/data";
---

<div>
  <Heading heading="About" />
  <div class="font-medium pl-4 text-sm space-y-4 leading-6.5">
    <p>Hi,</p>
    <p>
      I'm Rahul Palamarthi, a{" "}
      <span class="italic font-baskerville text-mauve-900">design</span> and{" "}
      <span class="font-semibold text-mauve-900">software</span> engineer.
    </p>
    <p>
      Currently working as founding engineer at{" "}
      <a
        href={CURRENT_COMPANY.href}
        class="group/curr-company text-mauve-500/80 decoration-mauve-400 hover:decoration-wavy hover:decoration-mauve-900 hover:text-mauve-900 focus:decoration-wavy focus:decoration-mauve-900 focus:text-mauve-900 transition-colors duration-300 ease-out underline-offset-2"
        target="_blank"
        rel="noopener"
      >
        {CURRENT_COMPANY.label}
      </a>
      , building the frontend from the very beginning.
    </p>
  </div>
</div>
