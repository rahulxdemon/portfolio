---
import { NAV_LINKS } from "@/features/shared/data/nav";

const { pathname } = Astro.url;
const trimmedUrl =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
---

<nav
  class="font-baskerville bg-mauve-50/25 fixed bottom-0 w-full h-14 z-50 text-sm px-6 border-t border-t-mauve-100 backdrop-container backdrop-blur-[2.5px]"
  transition:animate="none"
>
  <div class="h-full">
    <div class="flex items-stretch justify-between max-w-158 px-0.5 mx-auto h-full">
      {NAV_LINKS.filter((link) => link.isEnabled).map((link) => {
        const isActive = trimmedUrl === link.linkOptions.to;

        return (
          <a
            class={`group flex-1 flex items-center justify-start gap-1.5 px-4 focus-visible:outline-text focus-visible:outline-1 italic no-underline transition-colors duration-300 py-[0.5ch] ${isActive ? "text-text" : "text-mauve-600 hover:text-mauve-600"}`}
            href={link.linkOptions.to}
            data-status={isActive ? "active" : "inactive"}
            aria-current={isActive ? "page" : "false"}
          >
            <span class="group-data-[status=active]:opacity-100 opacity-0 animate-text-cycle relative -top-px">
              ⟁
            </span>
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</nav>
