---
import { NAV_LINKS } from "@/features/shared/data/nav";

const { pathname } = Astro.url;
---

<nav class="font-baskerville fixed bottom-0 w-full h-14 z-30 text-sm">
  <div
    style={{
      backdropFilter: 'url("#svgfilter")',
    }}
    class="h-full"
  >
    <div class="flex items-center justify-start gap-6 max-w-158 px-0.5 mx-auto h-full">
      {NAV_LINKS.filter((link) => link.isEnabled).map((link) => {
        const isActive = pathname === link.linkOptions.to;

        return (
          <a
            class={`group focus-visible:outline-text focus-visible:outline-1 italic transition-colors duration-300 py-[0.5ch] ${isActive ? "text-text" : "text-neutral-500 hover:text-text/90"}`}
            href={link.linkOptions.to}
            data-status={isActive ? "active" : "inactive"}
            aria-current={isActive ? "page" : "false"}
          >
            <span class="group-data-[status=active]:opacity-100 opacity-0 animate-text-cycle">
              ▷
            </span>{" "}
            {link.label}
          </a>
        );
      })}
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0">
      <defs>
        <filter id="svgfilter">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.3"
            numOctaves="1"
            seed="0"
            stitchTiles="stitch"
            result="feTurbulence-391ac80d"
          />
          <feGaussianBlur
            in="SourceGraphic"
            stdDeviation="2"
            edgeMode="duplicate"
            result="feGaussianBlur-85e146a6"
          />
          <feDisplacementMap
            in="feGaussianBlur-85e146a6"
            in2="feTurbulence-391ac80d"
            scale="37"
            xChannelSelector="A"
            yChannelSelector="A"
          />
        </filter>
      </defs>
    </svg>
  </div>
</nav>
