---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  location: string;
}

const { src, alt, location } = Astro.props;
---

<div>
  <Image
    class="w-full inline-block"
    src={src}
    alt={alt}
    width={632}
    height={356}
    priority
  />
  <p class="text-xs text-mauve-400/75 text-end pt-2">{location}</p>
</div>
