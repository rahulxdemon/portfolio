---
import { Font } from "astro:assets";
import "../../../styles/main.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <link rel="icon" href="/assets/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Rahul Palamarthi</title>
    <meta name="title" content="Rahul Palamarthi" />
    <meta
      name="description"
      content="Product, craft, and thoughtful engineering."
    />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio-5p8.pages.dev/resume/" />
    <meta property="og:title" content="Rahul Palamarthi" />
    <meta property="og:description" content="Product, craft, and thoughtful engineering." />
    <meta property="og:image" content="/assets/og.png" />
    
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://portfolio-5p8.pages.dev/resume/" />
    <meta property="twitter:title" content="Rahul Palamarthi" />
    <meta property="twitter:description" content="Product, craft, and thoughtful engineering." />
    <meta property="twitter:image" content="/assets/og.png" />

    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-baskerville" preload />
    <Font cssVariable="--font-chivo" />
  </head>
  <body>
    <slot />
  </body>
</html>
