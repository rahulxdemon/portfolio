<span
  id="infra-content"
  class="font-semibold text-neutral-400/80 font-jakarta!"
>
  infrastructure
</span>

<script>
  import { drawablyUnderline } from "drawably";

  const elId = "infra-content";
  const el = document.getElementById(elId);

  if (el) {
    drawablyUnderline(el, {
      seed: 231451524,
      roughness: 1.3,
      boil: 1,
      width: 1.5,
      stroke: "#5eead4",
    });
  } else {
    console.log(`No element with id: ${elId}`);
  }
</script>
