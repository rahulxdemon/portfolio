<span class="infra-content-wrapper relative">
  <span
    id="infra-content"
    class="font-semibold text-neutral-400/80 font-jakarta!"
  >
    infrastructure
  </span>
  <svg
    id="infra-bar"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute w-full left-0 -bottom-0.5"
    aria-hidden="true"
  ></svg>
</span>

<style>
  .infra-content-wrapper rect {
    transition: fill 120ms ease;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const BLOCK = 2;
    const GAP = 2;
    const SPEED = 150;
    const PALETTE = [
      "#ff1744",
      "#ff6d00",
      "#ffea00",
      "#00e676",
      "#1de9b6",
      "#00e5ff",
      "#2979ff",
      "#d500f9",
      "#ff4081",
      "#76ff03",
      "#111111",
      "#404040",
      "#737373",
      "#a3a3a3",
      "#d4d4d4",
    ]; // first ten are vivid, last five are neutral grays

    const elId = "infra-content";
    const svgId = "infra-bar";
    const word = document.getElementById(elId);
    const svg = document.getElementById(svgId);

    const NS = "http://www.w3.org/2000/svg";
    let rects: SVGElement[] = [];
    let count = 0;
    let timer: NodeJS.Timeout;

    function build() {
      if (word && svg) {
        const width = word.getBoundingClientRect().width;
        count = Math.ceil((width + GAP) / (BLOCK + GAP)); // how many blocks fit
        const used = count * BLOCK + (count - 1) * GAP; // exact bar width
        svg.setAttribute("width", used.toString());
        svg.setAttribute("height", BLOCK.toString());
        svg.setAttribute("viewBox", `0 0 ${used} ${BLOCK}`);
        // svg.style.marginLeft = (width - used) / 2 + "px"; // centre under the word
        svg.innerHTML = "";
        rects = [];
        for (let i = 0; i < count; i++) {
          const r = document.createElementNS(NS, "rect");
          r.setAttribute("x", (i * (BLOCK + GAP)).toString());
          r.setAttribute("width", BLOCK.toString());
          r.setAttribute("height", BLOCK.toString());
          r.setAttribute("fill", "#000");
          svg.appendChild(r);
          rects.push(r);
        }
      } else {
        console.log(`No element with id: ${elId} or ${svgId}`);
      }
    }

    // Give every block a new random colour (never the same as its current one)
    function shuffle() {
      rects.forEach((r) => {
        const cur = r.getAttribute("fill");
        let c;
        do {
          c = PALETTE[Math.floor(Math.random() * PALETTE.length)];
        } while (c === cur);
        r.setAttribute("fill", c);
      });
    }

    function start() {
      clearInterval(timer);
      build();
      shuffle();
      timer = setInterval(shuffle, SPEED);
    }

    (document.fonts && document.fonts.ready
      ? document.fonts.ready
      : Promise.resolve()
    ).then(start);
    window.addEventListener("resize", start);
  });
</script>
