<span id="infra-content" class="font-semibold text-olive-400 font-jakarta!">
  infrastructure
</span>

<script>
  import { drawablyUnderline } from "drawably";

  document.addEventListener("astro:page-load", () => {
    const elId = "infra-content";
    const el = document.getElementById(elId);

    if (el) {
      drawablyUnderline(el, {
        seed: 231451524,
        roughness: 1.3,
        boil: 1,
        width: 1.5,
        stroke: "#94a599",
      });
    } else {
      console.log(`No element with id: ${elId}`);
    }
  });
</script>
