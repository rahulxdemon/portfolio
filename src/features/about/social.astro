---
import {
  GITHUB_SOCIAL,
  TWITTER_SOCIAL,
  LINKEDIN_SOCIAL,
} from "@/features/social/data";
---

<p class="social-wrapper">
  <span class="relative">
    Liked
    <span class="tlike like-emj -translate-1/2 absolute top-0 left-1">🩷</span>
    <span class="tlike like-emj -translate-1/2 absolute top-1/3 left-7/8 delay-200">
      🩷
    </span>
    <span class="tlike like-emj -translate-x-1/2 absolute top-1/2 left-2/4 delay-100">
      🩷
    </span>
    <span class="glike like-emj -translate-1/2 absolute top-0 left-3">❤️</span>
    <span class="glike like-emj -translate-1/2 absolute top-4 left-full delay-200">
      ❤️
    </span>
    <span class="glike like-emj -translate-x-1/2 absolute top-1/2 left-0 delay-100">
      ❤️
    </span>
    <span class="llike like-emj -translate-1/2 absolute top-0.5 left-0">
      🩵
    </span>
    <span class="llike like-emj -translate-1/2 absolute -top-0.5 left-2/3 delay-200">
      🩵
    </span>
    <span class="llike like-emj -translate-x-1/2 absolute top-1 left-full delay-100">
      🩵
    </span>
  </span>{" "}
  what you found? I'm on{" "}
  <a
    class="social-link t-link"
    href={TWITTER_SOCIAL.href}
    target="_blank"
    rel="noopener"
  >
    {TWITTER_SOCIAL.label}
  </a>
  ,{" "}
  <a
    class="social-link g-link"
    href={GITHUB_SOCIAL.href}
    target="_blank"
    rel="noopener"
  >
    {GITHUB_SOCIAL.label}
  </a>
  , and{" "}
  <a
    class="social-link l-link"
    href={LINKEDIN_SOCIAL.href}
    target="_blank"
    rel="noopener"
  >
    {LINKEDIN_SOCIAL.label}
  </a>
  .
</p>
